# Examples only. The app reads environment variables; this file is NOT auto-loaded.
# PowerShell example: $env:FARIDA_REQUEST_INTERVAL = "3"
# Default storage: %LOCALAPPDATA%\FaridaSongBrowser (Windows).
# FARIDA_DATA_DIR=C:\Users\YOUR_NAME\AppData\Local\FaridaSongBrowser
FARIDA_REQUEST_INTERVAL=2
FARIDA_REQUEST_TIMEOUT=20
FARIDA_DISCOVERY_PAGES=20
FARIDA_INCREMENTAL_PAGES=3
FARIDA_STALE_HOURS=24
# Optional: an absolute path to a private UTF-8 file containing YOUR Cookie header.
# Keep that file outside Git and outside the frontend directory.
# FARIDA_COOKIE_FILE=C:\Users\YOUR_NAME\AppData\Local\FaridaSongBrowser\session.txt
